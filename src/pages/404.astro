---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" noindex={true}>
  <section class="container not-found-shell">
    <div class="mono-meta">HTTP 404</div>
    <h1>Page not found</h1>
    <p class="not-found-desc">
      The requested route does not exist on this site. You can search across all historical articles, projects, and laboratory experiments below.
    </p>
    <div class="not-found-actions">
      <button type="button" class="btn btn-primary" data-open-search>
        Search Site (⌘K)
      </button>
      <a href="/" class="btn">Return Home</a>
      <a href="/blog/" class="btn">Browse Writing</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-shell {
    padding-block: clamp(4rem, 10vw, 8rem);
    max-width: 64ch;
  }

  .not-found-shell h1 {
    margin: 0.5rem 0 1rem;
    font-size: var(--text-3xl);
    letter-spacing: -0.03em;
  }

  .not-found-desc {
    color: var(--ink-secondary);
    margin-bottom: 1.75rem;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
