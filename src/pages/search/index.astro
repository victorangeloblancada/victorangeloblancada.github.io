---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublishedPost } from '../../utils/routing';
import { normalizeTagSlug } from '../../utils/tags';

const publishedPosts = (await getCollection('blog')).filter(isPublishedPost);
const projects = await getCollection('projects');
const labEntries = await getCollection('lab');

const allTags = Array.from(
  new Set([
    ...publishedPosts.flatMap((p) => p.data.tags.map(normalizeTagSlug)),
    ...projects.flatMap((p) => p.data.tags.map(normalizeTagSlug)),
    ...labEntries.flatMap((p) => p.data.tags.map(normalizeTagSlug)),
  ]),
).sort();

const allCategories = Array.from(
  new Set([
    ...publishedPosts.map((p) => normalizeTagSlug(p.data.category || 'blog')),
    ...projects.flatMap((p) =>
      (p.data.categories.length ? p.data.categories : ['case-study']).map(normalizeTagSlug),
    ),
    ...(labEntries.length ? ['laboratory'] : []),
    'profile',
  ]),
).sort();
---

<BaseLayout
  title="Search Archive"
  description="Full-text static search across blog posts, project case studies, laboratory experiments, and profile pages."
>
  <section class="container search-page-shell">
    <header class="search-page-header fade-settle">
      <div class="section-kicker">Full-Text Static Search · Pagefind</div>
      <h1 class="search-page-title">Search Archive</h1>
      <p class="search-page-lead">
        Query across {publishedPosts.length} published articles, {projects.length} project case studies, {labEntries.length} laboratory experiments, and profile pages. You can also press <kbd>⌘K</kbd> or <kbd>Ctrl+K</kbd> anywhere on the site.
      </p>
    </header>

    <div class="search-controls">
      <div class="search-box-row">
        <label for="page-search-input" class="sr-only">Search query</label>
        <input
          id="page-search-input"
          type="search"
          class="search-input"
          placeholder="Search machine learning, Maersk, supply chain, KaTeX, optimization..."
          autocomplete="off"
        />
      </div>

      <div class="search-facets">
        <div class="facet-group" role="group" aria-label="Filter by content type">
          <button type="button" class="filter-chip active" data-page-type="all">All</button>
          <button type="button" class="filter-chip" data-page-type="blog">Writing</button>
          <button type="button" class="filter-chip" data-page-type="project">Projects</button>
          <button type="button" class="filter-chip" data-page-type="lab">Laboratory</button>
          <button type="button" class="filter-chip" data-page-type="page">Profiles</button>
        </div>

        <div class="facet-select-group">
          <div class="facet-tag">
            <label for="page-category-select" class="mono-meta">Category:</label>
            <select id="page-category-select" class="tag-select">
              <option value="">All categories</option>
              {allCategories.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>

          <div class="facet-tag">
            <label for="page-tag-select" class="mono-meta">Tag:</label>
            <select id="page-tag-select" class="tag-select">
              <option value="">All tags</option>
              {allTags.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </div>
      </div>
    </div>

    <div id="page-search-status" class="mono-meta search-status" aria-live="polite">
      Enter a search term or pick a category, type, or tag filter.
    </div>

    <ol id="page-search-results" class="page-search-results"></ol>
  </section>
</BaseLayout>

<style>
  .search-page-shell {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 5vw, 5rem);
    max-width: 900px;
  }

  .search-page-title {
    margin: 0.4rem 0 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .search-page-lead {
    color: var(--ink-secondary);
    margin: 0 0 1.75rem;
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.1rem 0.38rem;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    background: var(--bg-surface);
  }

  .search-controls {
    display: grid;
    gap: 0.85rem;
    padding: 1.1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  .search-input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg-elevated);
    font-size: 1rem;
  }

  .search-facets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .facet-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-chip {
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.28rem 0.68rem;
    border-radius: 999px;
    cursor: pointer;
  }

  .filter-chip.active {
    border-color: var(--accent-border);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .facet-select-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .facet-tag {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .tag-select {
    padding: 0.32rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .search-status {
    margin-block: 1.15rem;
  }

  .page-search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .page-search-results :global(.result-card) {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    padding: 1.1rem 1.25rem;
  }

  .page-search-results :global(.result-card:hover) {
    border-color: var(--accent-border);
  }

  .page-search-results :global(.result-card a) {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .page-search-results :global(.result-meta) {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .page-search-results :global(.result-title) {
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--ink-primary);
    margin-bottom: 0.35rem;
  }

  .page-search-results :global(.result-excerpt) {
    font-size: 0.92rem;
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  .page-search-results :global(mark) {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0 0.15rem;
    border-radius: 2px;
  }
</style>

<script is:inline>
  (function () {
    var pf = null;
    var currentType = 'all';
    var timer = null;

    async function loadPf() {
      if (pf) return pf;
      try {
        var mod = await import('/pagefind/pagefind.js');
        await mod.init();
        pf = mod;
        return mod;
      } catch (_) {
        return null;
      }
    }

    function esc(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    async function executeSearch() {
      var input = document.getElementById('page-search-input');
      var catSelect = document.getElementById('page-category-select');
      var tagSelect = document.getElementById('page-tag-select');
      var statusEl = document.getElementById('page-search-status');
      var resultsEl = document.getElementById('page-search-results');
      if (!input || !catSelect || !tagSelect || !statusEl || !resultsEl) return;

      var query = input.value.trim();
      var catVal = catSelect.value;
      var tagVal = tagSelect.value;

      var url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      if (catVal) url.searchParams.set('category', catVal);
      else url.searchParams.delete('category');
      if (tagVal) url.searchParams.set('tag', tagVal);
      else url.searchParams.delete('tag');
      window.history.replaceState({}, '', url.toString());

      if (!query && !catVal && !tagVal && currentType === 'all') {
        statusEl.textContent = 'Enter a search term or pick a category, type, or tag filter.';
        resultsEl.innerHTML = '';
        return;
      }

      var engine = await loadPf();
      if (!engine) {
        statusEl.textContent =
          'Pagefind index is generated during production build (npm run build).';
        return;
      }

      var filters = {};
      if (currentType !== 'all') filters.type = currentType;
      if (catVal) filters.category = catVal;
      if (tagVal) filters.tag = tagVal;

      var res = await engine.search(query || null, Object.keys(filters).length ? { filters: filters } : undefined);
      var docs = await Promise.all(res.results.slice(0, 30).map(function (r) { return r.data(); }));

      statusEl.textContent =
        res.results.length + ' result' + (res.results.length === 1 ? '' : 's') + ' found.';

      resultsEl.innerHTML = docs
        .map(function (d) {
          var title = esc((d.meta && d.meta.title) || d.url);
          var date = esc((d.meta && d.meta.date) || '');
          var typeLabel = esc((d.filters && d.filters.type && d.filters.type[0]) || 'page');
          return (
            '<li class="result-card"><a href="' +
            esc(d.url) +
            '">' +
            '<div class="result-meta"><span>' +
            typeLabel +
            '</span>' +
            (date ? '<span>· ' + date + '</span>' : '') +
            '</div>' +
            '<div class="result-title">' +
            title +
            '</div>' +
            '<div class="result-excerpt">' +
            (d.excerpt || '') +
            '</div>' +
            '</a></li>'
          );
        })
        .join('');
    }

    function initSearchPage() {
      var input = document.getElementById('page-search-input');
      var catSelect = document.getElementById('page-category-select');
      var tagSelect = document.getElementById('page-tag-select');
      if (!input || !catSelect || !tagSelect || input.dataset.bound === '1') return;
      input.dataset.bound = '1';

      var params = new URLSearchParams(window.location.search);
      var q = params.get('q');
      var cat = params.get('category');
      var tag = params.get('tag');
      if (q) input.value = q;
      if (cat) catSelect.value = cat;
      if (tag) tagSelect.value = tag;
      if (q || cat || tag) executeSearch();

      input.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(executeSearch, 120);
      });

      catSelect.addEventListener('change', executeSearch);
      tagSelect.addEventListener('change', executeSearch);

      document.querySelectorAll('[data-page-type]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('[data-page-type]').forEach(function (b) {
            b.classList.remove('active');
          });
          btn.classList.add('active');
          currentType = btn.getAttribute('data-page-type') || 'all';
          executeSearch();
        });
      });
    }

    initSearchPage();
    document.addEventListener('astro:page-load', initSearchPage);
  })();
</script>
