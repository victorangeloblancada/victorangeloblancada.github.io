---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/editorial/PostCard.astro';
import { isPublishedPost, sortPostsDesc } from '../../../../utils/routing';
import { normalizeTagSlug } from '../../../../utils/tags';

export async function getStaticPaths() {
  const allPublished = sortPostsDesc((await getCollection('blog')).filter(isPublishedPost));
  const categories = Array.from(
    new Set(allPublished.map((p) => normalizeTagSlug(p.data.category || 'blog'))),
  );

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      posts: allPublished.filter(
        (p) => normalizeTagSlug(p.data.category || 'blog') === category,
      ),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={`Category: ${category}`}
  description={`Articles categorized under ${category}.`}
>
  <section class="container archive-shell">
    <header class="archive-header">
      <div class="section-kicker">Category · {posts.length} Articles</div>
      <h1 class="archive-title">{category}</h1>
      <p><a href="/blog/">← Back to Writing archive</a></p>
    </header>

    <div class="hairline-grid archive-grid">
      {posts.map((post) => <PostCard post={post} level={2} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .archive-shell {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 5vw, 5rem);
  }

  .archive-header {
    margin-bottom: 1.75rem;
  }

  .archive-title {
    margin: 0.4rem 0 0.5rem;
    font-size: var(--text-3xl);
    text-transform: capitalize;
  }

  .archive-grid {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
</style>
