---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/editorial/ReadingProgress.astro';
import TableOfContents from '../components/editorial/TableOfContents.astro';
import ShareLinks from '../components/editorial/ShareLinks.astro';
import PostCard from '../components/editorial/PostCard.astro';
import GalleryGrid from '../components/editorial/GalleryGrid.astro';
import Lightbox from '../components/editorial/Lightbox.astro';
import type { BlogEntry } from '../utils/routing';
import { formatDisplayDate, getPostUrl } from '../utils/routing';
import { estimateReadingTime } from '../utils/readingTime';
import { normalizeTagSlug } from '../utils/tags';
import { siteConfig } from '../config/site';
import 'katex/dist/katex.min.css';
import '../styles/prose.css';

export interface Props {
  entry: BlogEntry;
  headings: MarkdownHeading[];
  prevPost?: BlogEntry;
  nextPost?: BlogEntry;
  relatedPosts?: BlogEntry[];
  /** Resolvable at its legacy URL, but hidden from search engines and site search. */
  unlisted?: boolean;
}

const { entry, headings, prevPost, nextPost, relatedPosts = [], unlisted = false } = Astro.props;
const urlPath = getPostUrl(entry);
const canonicalUrl = new URL(urlPath, siteConfig.siteUrl).toString();
const reading = estimateReadingTime(entry.body);
const isoDate = entry.data.date.toISOString().slice(0, 10);
const normalizedTags = Array.from(new Set(entry.data.tags.map(normalizeTagSlug)));
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc =
  entry.data.toc !== undefined ? entry.data.toc : tocHeadings.length >= 3;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  canonicalUrl={canonicalUrl}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  modifiedTime={entry.data.updatedDate?.toISOString()}
  tags={normalizedTags}
  pagefindIndex={!unlisted}
  noindex={unlisted}
>
  <ReadingProgress />

  <article class="container article-shell">
    <!-- Hidden Pagefind metadata & filters -->
    <span class="sr-only" data-pagefind-filter="type">blog</span>
    <span class="sr-only" data-pagefind-filter="category">{normalizeTagSlug(entry.data.category || 'blog')}</span>
    <span class="sr-only" data-pagefind-meta="date">{isoDate}</span>
    {
      normalizedTags.map((t) => (
        <span class="sr-only" data-pagefind-filter="tag">
          {t}
        </span>
      ))
    }

    <header class="article-header fade-settle">
      <div class="article-breadcrumb mono-meta">
        <a href="/blog/">Writing</a>
        <span>/</span>
        <a href={`/blog/year/${isoDate.slice(0, 4)}/`}>{isoDate.slice(0, 4)}</a>
        <span>·</span>
        <time datetime={isoDate}>{formatDisplayDate(entry.data.date)}</time>
        <span>·</span>
        <span>{reading.label}</span>
      </div>

      <h1 class="article-title" data-pagefind-meta="title">
        {entry.data.title}
      </h1>

      {
        entry.data.description && (
          <p class="article-lead">{entry.data.description}</p>
        )
      }

      <div class="article-rule rule-draw" aria-hidden="true"></div>

      {
        entry.data.image && (
          <figure class="article-hero-figure">
            <img
              src={entry.data.image}
              alt={entry.data.title}
              loading="eager"
              decoding="async"
            />
          </figure>
        )
      }
    </header>

    <div class:list={['article-grid', { 'has-toc': showToc }]}>
      <div class="article-main">
        {
          showToc && tocHeadings.length > 0 && (
            <details class="mobile-toc no-print">
              <summary class="mono-meta">Contents ({tocHeadings.length} sections)</summary>
              <ol class="mobile-toc-list">
                {tocHeadings.map((h) => (
                  <li class:list={[{ 'toc-sub': h.depth === 3 }]}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div class:list={['prose', { dropcap: entry.data.dropcap }]}>
          <slot />
        </div>

        {entry.data.gallery && <GalleryGrid folder={entry.data.gallery} />}

        <footer class="article-footer no-print">
          {
            !entry.data.notshareable && (
              <div class="article-footer-row">
                <ShareLinks title={entry.data.title} urlPath={urlPath} />
              </div>
            )
          }

          {
            !unlisted && normalizedTags.length > 0 && (
              <div class="article-footer-tags">
                <span class="mono-meta">Filed under:</span>
                <ul class="tag-list">
                  {normalizedTags.map((slug) => (
                    <li>
                      <a href={`/blog/tag/${slug}/`} class="tag-chip">
                        {slug}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            (prevPost || nextPost) && (
              <nav class="post-nav-grid" aria-label="Adjacent articles">
                <div>
                  {prevPost && (
                    <a href={getPostUrl(prevPost)} class="post-nav-card">
                      <span class="mono-meta">← Older article</span>
                      <strong>{prevPost.data.title}</strong>
                    </a>
                  )}
                </div>
                <div>
                  {nextPost && (
                    <a href={getPostUrl(nextPost)} class="post-nav-card align-right">
                      <span class="mono-meta">Newer article →</span>
                      <strong>{nextPost.data.title}</strong>
                    </a>
                  )}
                </div>
              </nav>
            )
          }
          {
            !unlisted && (
              <div class="author-bridge">
                <div>
                  <span class="mono-meta">About the author</span>
                  <p class="author-bridge-text">
                    Victor Angelo Blancada — Head of AI &amp; Quantitative Modeling (<span data-years-experience={siteConfig.careerStartYear}>{siteConfig.yearsExperience}+</span> years across Generative AI, optimization, and decision systems).
                  </p>
                </div>
                <div class="author-bridge-links">
                  <a href="/pages/about.html" class="btn">Background</a>
                  <a href="/projects/" class="btn">Case Studies</a>
                  <a href="/pages/resume-downloads.html" class="btn">Résumé &amp; CV</a>
                </div>
              </div>
            )
          }
        </footer>
      </div>

      {showToc && <TableOfContents headings={headings} />}
    </div>

    {
      relatedPosts.length > 0 && (
        <section class="related-section no-print" aria-labelledby="related-heading">
          <div class="section-header">
            <div>
              <span class="section-kicker">Continue Reading</span>
              <h2 id="related-heading" class="section-title">
                Related Articles
              </h2>
            </div>
            <a href="/blog/" class="mono-meta">
              Browse full archive →
            </a>
          </div>
          <div class="hairline-grid related-grid">
            {relatedPosts.map((rp) => (
              <PostCard post={rp} compact={true} />
            ))}
          </div>
        </section>
      )
    }
  </article>

  <button
    type="button"
    id="back-to-top"
    class="back-to-top no-print"
    aria-label="Back to top"
    hidden
  >
    ↑ Top
  </button>

  <Lightbox />
</BaseLayout>

<style>
  .article-shell {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 5vw, 5rem);
  }

  .article-header {
    max-width: 78ch;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .article-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
  }

  .article-breadcrumb a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .article-breadcrumb a:hover {
    color: var(--accent);
  }

  .article-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.08;
    color: var(--ink-heading);
  }

  .article-lead {
    margin: 0.9rem 0 0;
    font-size: clamp(1.02rem, 0.98rem + 0.35vw, 1.18rem);
    color: var(--ink-secondary);
    line-height: 1.55;
    max-width: 64ch;
  }

  .article-rule {
    height: 1px;
    background: var(--border-subtle);
    margin-top: 1.5rem;
  }

  .article-hero-figure {
    margin: 1.5rem 0 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-surface);
  }

  .article-hero-figure img {
    width: 100%;
    max-height: 440px;
    object-fit: cover;
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 1080px) {
    .article-grid.has-toc {
      grid-template-columns: minmax(0, var(--prose-max)) minmax(220px, 1fr);
      align-items: stretch;
      gap: 3.5rem;
    }
  }

  .article-main {
    min-width: 0;
  }

  .mobile-toc {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  @media (min-width: 1080px) {
    .mobile-toc {
      display: none;
    }
  }

  .mobile-toc summary {
    cursor: pointer;
    color: var(--ink-heading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mobile-toc-list {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-sm);
  }

  .mobile-toc-list .toc-sub {
    padding-left: 0.75rem;
  }

  .author-bridge {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  @media (min-width: 720px) {
    .author-bridge {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .author-bridge-text {
    margin: 0.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--ink-primary);
    max-width: 52ch;
  }

  .author-bridge-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-subtle);
    display: grid;
    gap: 1.35rem;
  }

  .article-footer-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .post-nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    text-decoration: none;
    color: var(--ink-primary);
    height: 100%;
  }

  .post-nav-card:hover {
    border-color: var(--accent-border);
  }

  .post-nav-card.align-right {
    text-align: right;
  }

  .related-section {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .related-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 35;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg-elevated);
    color: var(--ink-primary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }

  .back-to-top:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>

<script is:inline>
  (function () {
    function enhanceArticle() {
      // Inject copy-code buttons cleanly on Shiki pre blocks
      document.querySelectorAll('.prose pre').forEach(function (pre) {
        if (pre.parentElement && pre.parentElement.classList.contains('code-block-wrap')) return;
        var wrap = document.createElement('div');
        wrap.className = 'code-block-wrap';

        var bar = document.createElement('div');
        bar.className = 'code-block-bar no-print';

        var lang = pre.getAttribute('data-language') || 'code';
        var label = document.createElement('span');
        label.textContent = lang;

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy-btn';
        btn.textContent = 'Copy';
        btn.addEventListener('click', function () {
          var codeText = pre.innerText || '';
          function markCopied() {
            btn.textContent = 'Copied';
            setTimeout(function () {
              btn.textContent = 'Copy';
            }, 1600);
          }
          function fallbackCopy() {
            try {
              var ta = document.createElement('textarea');
              ta.value = codeText;
              ta.setAttribute('readonly', '');
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              var ok = document.execCommand && document.execCommand('copy');
              document.body.removeChild(ta);
              if (ok) {
                markCopied();
                return;
              }
            } catch (_) {}
            btn.textContent = 'Unavailable';
            setTimeout(function () {
              btn.textContent = 'Copy';
            }, 1600);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(codeText).then(markCopied, fallbackCopy);
          } else {
            fallbackCopy();
          }
        });

        bar.appendChild(label);
        bar.appendChild(btn);
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(bar);
        wrap.appendChild(pre);
      });

      // Back to top button visibility
      var topBtn = document.getElementById('back-to-top');
      if (topBtn && topBtn.dataset.bound !== '1') {
        topBtn.dataset.bound = '1';
        topBtn.addEventListener('click', function () {
          var reduce =
            window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      }
      function updateTopBtn() {
        var btn = document.getElementById('back-to-top');
        if (!btn) return;
        btn.hidden = window.scrollY < 450;
      }
      if (!window.__backToTopBound) {
        window.__backToTopBound = true;
        window.addEventListener('scroll', updateTopBtn, { passive: true });
      }
      updateTopBtn();
    }

    enhanceArticle();
    document.addEventListener('astro:page-load', enhanceArticle);
  })();
</script>
