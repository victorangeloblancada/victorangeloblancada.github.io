---
import type { MarkdownHeading } from 'astro';

export interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.text.trim().length > 0);
---

{
  tocHeadings.length > 0 && (
    <aside class="toc-rail no-print" aria-label="Table of contents">
      <div class="toc-sticky">
        <div class="toc-head">
          <span class="toc-title">On this page</span>
          <span class="toc-pct mono-meta" data-toc-percent>0%</span>
        </div>
        <div class="toc-track" aria-hidden="true">
          <div class="toc-track-fill" data-toc-progress></div>
        </div>
        <nav>
          <ul class="toc-list">
            {tocHeadings.map((heading) => (
              <li class:list={['toc-item', { 'toc-sub': heading.depth === 3 }]}>
                <a href={`#${heading.slug}`} class="toc-link" data-toc-slug={heading.slug}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>
  )
}

<style>
  .toc-rail {
    display: none;
  }

  @media (min-width: 1080px) {
    .toc-rail {
      display: block;
      position: relative;
      align-self: stretch;
    }

    .toc-sticky {
      position: sticky;
      top: calc(var(--nav-height) + 1.75rem);
      padding-left: 1.15rem;
      border-left: 1px solid var(--border-subtle);
      max-height: calc(100vh - var(--nav-height) - 3.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }

  .toc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }

  .toc-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  .toc-track {
    position: relative;
    height: 2px;
    width: 100%;
    background: var(--border-subtle);
    margin-bottom: 0.85rem;
    overflow: hidden;
  }

  .toc-track-fill {
    width: 100%;
    height: 100%;
    background: var(--accent-bright);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 80ms linear;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .toc-sub {
    padding-left: 0.85rem;
  }

  .toc-link {
    display: block;
    position: relative;
    padding: 0.14rem 0 0.14rem 0.55rem;
    border-left: 2px solid transparent;
    margin-left: -0.55rem;
    font-size: 0.84rem;
    line-height: 1.38;
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-instrument),
      border-color var(--dur-fast) var(--ease-instrument);
  }

  .toc-link.passed {
    color: var(--ink-secondary);
  }

  .toc-link:hover,
  .toc-link.active {
    color: var(--accent);
  }

  .toc-link.active {
    border-left-color: var(--accent-bright);
    color: var(--accent);
  }
</style>

<script is:inline>
  (function () {
    var cleanupScroll = null;

    function bindTocScrollTracker() {
      if (cleanupScroll) {
        cleanupScroll();
        cleanupScroll = null;
      }

      var stickyBox = document.querySelector('.toc-sticky');
      var links = Array.from(document.querySelectorAll('[data-toc-slug]'));
      var fillBar = document.querySelector('[data-toc-progress]');
      var pctEl = document.querySelector('[data-toc-percent]');
      var articleEl = document.querySelector('.article-main');
      if (!links.length) return;

      var items = links
        .map(function (link) {
          var slug = link.getAttribute('data-toc-slug') || '';
          var heading = document.getElementById(slug);
          return heading ? { link: link, heading: heading, slug: slug } : null;
        })
        .filter(Boolean);

      if (!items.length) return;

      var rafPending = false;
      var lastActiveIdx = -1;

      function updateTocState() {
        rafPending = false;
        var offsetThreshold = 130;
        var activeIdx = 0;

        for (var i = 0; i < items.length; i++) {
          var rect = items[i].heading.getBoundingClientRect();
          if (rect.top <= offsetThreshold) {
            activeIdx = i;
          } else {
            break;
          }
        }

        // If scrolled to the very bottom of the article, mark the final heading active
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 24) {
          activeIdx = items.length - 1;
        }

        items.forEach(function (item, idx) {
          var isActive = idx === activeIdx;
          var isPassed = idx < activeIdx;
          item.link.classList.toggle('active', isActive);
          item.link.classList.toggle('passed', isPassed);
          if (isActive) {
            item.link.setAttribute('aria-current', 'location');
          } else {
            item.link.removeAttribute('aria-current');
          }
        });

        // Adjust ONLY internal ToC scrollTop when active section changes; never scroll the window
        if (stickyBox && activeIdx !== lastActiveIdx && stickyBox.scrollHeight > stickyBox.clientHeight) {
          var activeEl = items[activeIdx].link;
          var elTop = activeEl.offsetTop;
          var elBot = elTop + activeEl.offsetHeight;
          var viewTop = stickyBox.scrollTop;
          var viewBot = viewTop + stickyBox.clientHeight;
          if (elTop < viewTop + 36) {
            stickyBox.scrollTop = Math.max(0, elTop - 36);
          } else if (elBot > viewBot - 24) {
            stickyBox.scrollTop = elBot - stickyBox.clientHeight + 24;
          }
        }
        lastActiveIdx = activeIdx;

        // Article scroll progress readout inside ToC header
        var ratio = 0;
        if (articleEl) {
          var aTop = articleEl.offsetTop;
          var aHeight = Math.max(1, articleEl.offsetHeight - window.innerHeight * 0.65);
          ratio = Math.min(1, Math.max(0, (window.scrollY - aTop + 120) / aHeight));
        } else {
          var maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          ratio = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        }
        if (fillBar) fillBar.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';
        if (pctEl) pctEl.textContent = Math.round(ratio * 100) + '%';
      }

      function onScroll() {
        if (!rafPending) {
          rafPending = true;
          window.requestAnimationFrame(updateTocState);
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateTocState();

      cleanupScroll = function () {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      };
    }

    bindTocScrollTracker();
    document.addEventListener('astro:page-load', bindTocScrollTracker);
  })();
</script>
