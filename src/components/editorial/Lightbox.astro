<dialog id="image-lightbox" class="lightbox-dialog no-print" aria-label="Expanded image viewer">
  <div class="lightbox-frame">
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close image preview">
      Close (Esc)
    </button>
    <img id="lightbox-target" src="" alt="" />
    <p id="lightbox-caption" class="mono-meta lightbox-caption"></p>
  </div>
</dialog>

<style>
  .lightbox-dialog {
    max-width: min(94vw, 1100px);
    max-height: 92dvh;
    padding: 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    color: var(--ink-primary);
    box-shadow: var(--shadow-md);
  }

  .lightbox-dialog::backdrop {
    background: var(--backdrop-scrim);
    backdrop-filter: blur(4px);
  }

  .lightbox-frame {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    align-items: center;
  }

  .lightbox-close {
    align-self: flex-end;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    color: var(--ink-primary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  #lightbox-target {
    max-height: 76dvh;
    max-width: 100%;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .lightbox-caption {
    margin: 0;
    text-align: center;
  }
</style>

<script is:inline>
  (function () {
    function bindLightbox() {
      var dialog = document.getElementById('image-lightbox');
      var target = document.getElementById('lightbox-target');
      var caption = document.getElementById('lightbox-caption');
      if (!dialog || !target || !caption) return;

      document.querySelectorAll('.prose img, [data-lightbox-img]').forEach(function (img) {
        if (img.dataset.lightboxBound === '1') return;
        img.dataset.lightboxBound = '1';
        img.addEventListener('click', function () {
          target.src = img.currentSrc || img.src;
          target.alt = img.alt || '';
          caption.textContent = img.alt || '';
          if (!dialog.open) dialog.showModal();
        });
      });

      var closeBtn = dialog.querySelector('[data-lightbox-close]');
      if (closeBtn && closeBtn.dataset.bound !== '1') {
        closeBtn.dataset.bound = '1';
        closeBtn.addEventListener('click', function () {
          dialog.close();
        });
      }

      if (dialog.dataset.bound !== '1') {
        dialog.dataset.bound = '1';
        dialog.addEventListener('click', function (e) {
          if (e.target === dialog) dialog.close();
        });
      }
    }
    bindLightbox();
    document.addEventListener('astro:page-load', bindLightbox);
  })();
</script>
