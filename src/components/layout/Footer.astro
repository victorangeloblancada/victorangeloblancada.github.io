---
import { siteConfig } from '../../config/site';
---

<footer class="site-footer no-print">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-name">{siteConfig.title}</div>
      <p class="footer-note">
        Personal portfolio, technical publication, and interactive research laboratory.
      </p>
      <p class="mono-meta">
        © <span data-current-year>{siteConfig.currentYear}</span> Victor Angelo Blancada. Built statically with Astro.
      </p>
    </div>

    <div class="footer-cols">
      <div>
        <div class="footer-col-title">Navigation</div>
        <ul class="footer-links">
          <li><a href="/projects/">Selected Work</a></li>
          <li><a href="/blog/">Writing Archive</a></li>
          <li><a href="/lab/">Laboratory</a></li>
          <li><a href="/pages/about.html">About</a></li>
          <li><a href="/pages/resume-downloads.html">Résumé &amp; CV</a></li>
        </ul>
      </div>

      <div>
        <div class="footer-col-title">Discovery &amp; Connect</div>
        <ul class="footer-links">
          <li><a href="/search/">Site Search</a></li>
          <li><a href="/blog.html">All Posts &amp; Tags</a></li>
          <li><a href="/feed.xml">RSS / Atom Feed</a></li>
          <li><a href={siteConfig.author.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={siteConfig.author.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={`mailto:${siteConfig.author.email}`}>Email</a></li>
          {
            siteConfig.analytics.enabled && (
              <li>
                <button type="button" class="footer-pref-btn" data-open-cookie-banner>
                  Cookie Preferences
                </button>
              </li>
            )
          }
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    padding-block: clamp(2rem, 4vw, 3.25rem);
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }

  .footer-name {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.015em;
  }

  .footer-note {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    max-width: 44ch;
    margin: 0.45rem 0 0.85rem;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .footer-col-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin-bottom: 0.65rem;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: var(--text-sm);
  }

  .footer-links a {
    color: var(--ink-secondary);
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-pref-btn:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .footer-pref-btn {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--ink-secondary);
    cursor: pointer;
    text-align: left;
  }
</style>
