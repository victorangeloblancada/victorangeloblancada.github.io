<dialog id="search-modal" class="search-modal" aria-label="Search site">
  <div class="search-modal-surface">
    <div class="search-modal-header">
      <div class="search-input-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          id="modal-search-input"
          type="search"
          placeholder="Search articles, projects, and laboratory experiments..."
          autocomplete="off"
          aria-label="Search query"
        />
      </div>
      <button type="button" class="modal-close-btn" data-close-search aria-label="Close search">
        Esc
      </button>
    </div>

    <div class="search-filters" role="group" aria-label="Filter results by type">
      <button type="button" class="filter-pill active" data-type-filter="all">All</button>
      <button type="button" class="filter-pill" data-type-filter="blog">Writing</button>
      <button type="button" class="filter-pill" data-type-filter="project">Projects</button>
      <button type="button" class="filter-pill" data-type-filter="lab">Laboratory</button>
      <a href="/search/" class="full-search-link">Full search page →</a>
    </div>

    <div id="modal-search-status" class="search-status mono-meta" aria-live="polite">
      Type to search across the archive, or press ↑/↓ to navigate results.
    </div>

    <ol id="modal-search-results" class="search-results"></ol>
  </div>
</dialog>

<style>
  .search-modal {
    width: min(720px, calc(100vw - 2rem));
    max-height: min(80dvh, 680px);
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    color: var(--ink-primary);
    box-shadow: var(--shadow-md);
    margin: min(10vh, 5rem) auto auto;
  }

  .search-modal::backdrop {
    background: var(--backdrop-scrim);
    backdrop-filter: blur(4px);
  }

  .search-modal-surface {
    display: flex;
    flex-direction: column;
    max-height: min(80dvh, 680px);
  }

  .search-modal-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .search-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink-muted);
  }

  #modal-search-input {
    width: 100%;
    border: none;
    background: transparent;
    color: var(--ink-primary);
    font-size: 1rem;
    outline: none;
  }

  .modal-close-btn {
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .search-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .filter-pill {
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    cursor: pointer;
  }

  .filter-pill.active {
    border-color: var(--accent-border);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .full-search-link {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-decoration: none;
  }

  .search-status {
    padding: 0.55rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    overflow-y: auto;
    display: grid;
    gap: 0.35rem;
  }

  .search-results :global(.search-item a) {
    display: block;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    text-decoration: none;
    color: inherit;
  }

  .search-results :global(.search-item a:hover),
  .search-results :global(.search-item a:focus-visible),
  .search-results :global(.search-item a[aria-selected='true']) {
    background: var(--bg-surface);
    border-color: var(--border-strong);
  }

  .search-results :global(.search-item-meta) {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

  .search-results :global(.search-item-title) {
    font-weight: 600;
    color: var(--ink-primary);
    margin-bottom: 0.2rem;
  }

  .search-results :global(.search-item-excerpt) {
    font-size: 0.84rem;
    color: var(--ink-secondary);
    line-height: 1.45;
  }

  .search-results :global(mark) {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0 0.15rem;
    border-radius: 2px;
  }
</style>

<script is:inline>
  (function () {
    var pagefindInstance = null;
    var activeFilter = 'all';
    var debounceTimer = null;

    async function ensurePagefind() {
      if (pagefindInstance) return pagefindInstance;
      try {
        var mod = await import('/pagefind/pagefind.js');
        await mod.init();
        pagefindInstance = mod;
        return mod;
      } catch (_) {
        return null;
      }
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    async function runQuery(query) {
      var statusEl = document.getElementById('modal-search-status');
      var listEl = document.getElementById('modal-search-results');
      if (!statusEl || !listEl) return;

      var trimmed = (query || '').trim();
      if (!trimmed) {
        statusEl.textContent = 'Type to search across the archive, or press ↑/↓ to navigate results.';
        listEl.innerHTML = '';
        return;
      }

      var pf = await ensurePagefind();
      if (!pf) {
        statusEl.textContent =
          'Search index loads from production builds (run npm run build). Use /search/ for dedicated search.';
        return;
      }

      var filters = activeFilter === 'all' ? undefined : { type: activeFilter };
      var search = await pf.search(trimmed, filters ? { filters: filters } : undefined);
      var slice = search.results.slice(0, 10);
      var items = await Promise.all(slice.map(function (r) { return r.data(); }));

      statusEl.textContent =
        search.results.length +
        ' result' +
        (search.results.length === 1 ? '' : 's') +
        (activeFilter !== 'all' ? ' in ' + activeFilter : '');

      listEl.innerHTML = items
        .map(function (item, idx) {
          var title = escapeHtml((item.meta && item.meta.title) || item.url);
          var date = escapeHtml((item.meta && item.meta.date) || '');
          var typeLabel = escapeHtml((item.filters && item.filters.type && item.filters.type[0]) || 'page');
          return (
            '<li class="search-item">' +
            '<a href="' +
            escapeHtml(item.url) +
            '" data-search-result-idx="' +
            idx +
            '">' +
            '<div class="search-item-meta"><span>' +
            typeLabel +
            '</span>' +
            (date ? '<span>· ' + date + '</span>' : '') +
            '</div>' +
            '<div class="search-item-title">' +
            title +
            '</div>' +
            '<div class="search-item-excerpt">' +
            (item.excerpt || '') +
            '</div>' +
            '</a></li>'
          );
        })
        .join('');
    }

    function bindModal() {
      var modal = document.getElementById('search-modal');
      var input = document.getElementById('modal-search-input');
      if (!modal || !input) return;
      var lastFocusEl = null;

      function openModal() {
        if (!modal.open) {
          lastFocusEl = document.activeElement instanceof HTMLElement ? document.activeElement : null;
          modal.showModal();
          input.focus();
          ensurePagefind();
        }
      }

      function closeModal() {
        if (modal.open) {
          modal.close();
        }
      }

      document.querySelectorAll('[data-open-search]').forEach(function (el) {
        if (el.dataset.bound === '1') return;
        el.dataset.bound = '1';
        el.addEventListener('click', openModal);
      });

      document.querySelectorAll('[data-close-search]').forEach(function (el) {
        if (el.dataset.bound === '1') return;
        el.dataset.bound = '1';
        el.addEventListener('click', closeModal);
      });

      if (modal.dataset.bound !== '1') {
        modal.dataset.bound = '1';
        modal.addEventListener('close', function () {
          if (lastFocusEl && typeof lastFocusEl.focus === 'function' && document.contains(lastFocusEl)) {
            lastFocusEl.focus();
          }
          lastFocusEl = null;
        });
        modal.addEventListener('cancel', function (e) {
          e.preventDefault();
          closeModal();
        });
        modal.addEventListener('click', function (e) {
          if (e.target === modal) closeModal();
        });

        modal.querySelectorAll('[data-type-filter]').forEach(function (pill) {
          pill.addEventListener('click', function () {
            modal.querySelectorAll('[data-type-filter]').forEach(function (p) {
              p.classList.remove('active');
            });
            pill.classList.add('active');
            activeFilter = pill.getAttribute('data-type-filter') || 'all';
            runQuery(input.value);
          });
        });

        input.addEventListener('input', function () {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function () {
            runQuery(input.value);
          }, 120);
        });

        modal.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            e.preventDefault();
            closeModal();
            return;
          }
          var links = Array.from(modal.querySelectorAll('[data-search-result-idx]'));
          if (!links.length) return;
          var currentIdx = links.indexOf(document.activeElement);
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            var next = currentIdx < links.length - 1 ? links[currentIdx + 1] : links[0];
            next.focus();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (currentIdx <= 0) input.focus();
            else links[currentIdx - 1].focus();
          }
        });
      }

      if (!window.__searchShortcutBound) {
        window.__searchShortcutBound = true;
        document.addEventListener('keydown', function (e) {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            var currentModal = document.getElementById('search-modal');
            var currentInput = document.getElementById('modal-search-input');
            if (currentModal && !currentModal.open) {
              currentModal.showModal();
              if (currentInput) currentInput.focus();
              ensurePagefind();
            } else if (currentModal && currentModal.open) {
              currentModal.close();
            }
          }
        });
      }
    }

    bindModal();
    document.addEventListener('astro:page-load', bindModal);
  })();
</script>
