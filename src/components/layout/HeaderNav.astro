---
import { siteConfig } from '../../config/site';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;

function isActive(href: string, matchPrefix?: string): boolean {
  if (href === '/') return pathname === '/' || pathname === '/index.html';
  if (matchPrefix) return pathname.startsWith(matchPrefix);
  return pathname === href;
}
---

<header class="site-header no-print">
  <div class="container header-inner">
    <a href="/" class="brand-link" aria-label="Victor Angelo Blancada — Home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{siteConfig.title}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href, item.matchPrefix) }]}
            aria-current={isActive(item.href, item.matchPrefix) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="search-trigger"
        data-open-search
        aria-label="Open site search (Ctrl+K or Cmd+K)"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="search-label">Search</span>
        <kbd class="search-kbd">⌘K</kbd>
      </button>

      <ThemeToggle />

      <button
        type="button"
        class="mobile-menu-btn"
        data-mobile-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Toggle navigation menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav-drawer" class="mobile-drawer" hidden>
    <nav class="container mobile-nav-list" aria-label="Mobile navigation">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class:list={['mobile-nav-link', { active: isActive(item.href, item.matchPrefix) }]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/search/" class="mobile-nav-link">Search Archive</a>
      <a href="/pages/resume-downloads.html" class="mobile-nav-link">Résumé &amp; CV</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    color: var(--ink-heading);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: clamp(0.88rem, 0.82rem + 0.25vw, 1.02rem);
    white-space: nowrap;
  }

  .brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-mark {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    border-radius: 2px;
    background: var(--accent);
    display: inline-block;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition:
      color var(--dur-fast) var(--ease-instrument),
      text-decoration-color var(--dur-fast) var(--ease-instrument),
      background-color var(--dur-fast) var(--ease-instrument);
  }

  .nav-link:hover {
    color: var(--link-hover);
    text-decoration-color: var(--accent);
    background: var(--bg-surface);
  }

  .nav-link.active {
    color: var(--ink-heading);
    text-decoration: none;
    background: var(--bg-surface);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 36px;
    padding: 0 0.7rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    color: var(--ink-muted);
    font-size: var(--text-xs);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-instrument),
      color var(--dur-fast) var(--ease-instrument);
  }

  .search-trigger:hover {
    border-color: var(--accent-border);
    color: var(--ink-primary);
  }

  .search-label {
    display: none;
  }

  .search-kbd {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.08rem 0.35rem;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    background: var(--bg-elevated);
    color: var(--ink-muted);
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--ink-primary);
    cursor: pointer;
  }

  .mobile-drawer {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-canvas);
    padding-block: 0.75rem 1.15rem;
  }

  .mobile-nav-list {
    display: grid;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--ink-primary);
    text-decoration: none;
    font-size: 0.95rem;
    border: 1px solid transparent;
  }

  .mobile-nav-link.active {
    border-color: var(--border-subtle);
    background: var(--bg-surface);
    color: var(--accent);
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }

    .search-label,
    .search-kbd {
      display: inline;
    }

    .mobile-menu-btn,
    .mobile-drawer {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    function bindHeaderNav() {
      var btn = document.querySelector('[data-mobile-menu-toggle]');
      var drawer = document.getElementById('mobile-nav-drawer');
      if (!btn || !drawer || btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        drawer.hidden = expanded;
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !drawer.hidden) {
          drawer.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
    bindHeaderNav();
    document.addEventListener('astro:page-load', bindHeaderNav);
  })();
</script>
